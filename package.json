{
  "name": "mariana-semantic",
  "displayName": "Mariana Semantic",
  "description": "VSCode theme inspired on Mariana Sublime Text",
  "publisher": "lucas-curti",
  "version": "1.8.4",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.18.1 <21.0.0"
  },
  "packageManager": "pnpm@9.14.4",
  "icon": "img/icon.png",
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Mariana Semantic",
        "uiTheme": "vs-dark",
        "path": "./themes/mariana-semantic-color-theme.json"
      },
      {
        "label": "Mariana Semantic Light",
        "uiTheme": "vs",
        "path": "./themes/mariana-semantic-light-color-theme.json"
      }
    ]
  },
  "repository": "lucascurti/mariana-semantic-theme",
  "author": "Lucas Curti <lucas.curti@gmail.com>",
  "scripts": {
    "release": "auto shipit",
    "package": "vsce package",
    "publish:ovsx": "dotenv -- ovsx publish",
    "publish:vscode": "dotenv -- vsce publish",
    "test:ovsx": "echo 'Add OVSX_PAT=your_token to .env file'"
  },
  "devDependencies": {
    "@auto-it/all-contributors": "11.3.0",
    "@auto-it/first-time-contributor": "11.3.0",
    "@auto-it/git-tag": "11.3.0",
    "@auto-it/pr-body-labels": "11.3.0",
    "@auto-it/released": "11.3.0",
    "@auto-it/vscode": "11.3.0",
    "@vscode/vsce": "^3.2.1",
    "auto": "11.3.0",
    "dotenv-cli": "^7.4.2",
    "ovsx": "^0.9.5"
  }
}
